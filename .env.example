# ============================================
# Railway AI Platform - Environment Variables Template
# ============================================

# Database - PostgreSQL + PostGIS
DB_ENGINE=django.db.backends.postgresql
DB_NAME=railway_sih
DB_USER=railway_user
DB_PASSWORD=railway_password
DB_HOST=postgres
DB_PORT=5432

# Redis & Channels
REDIS_URL=redis://redis:6379/0

# Django Core
SECRET_KEY=django-insecure-change-this-in-production-use-long-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,channels,frontend,*

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Frontend Variables
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8001
MAPBOX_ACCESS_TOKEN=

# External AI & Telemetry
GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Ontology & Digital Twin
ONTOLOGY_FILE_PATH=/app/ontology/railway_digital_twin.owl
DJANGO_LOG_LEVEL=INFO
